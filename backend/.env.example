# Base de données PostgreSQL
DATABASE_URL="postgresql://fluxo:fluxo@localhost:5432/fluxo?schema=public"

# JWT
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-moi-aussi"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend (redirections OAuth, CORS)
FRONTEND_URL="http://localhost:4200"

# --- Authentification OAuth (uniquement Google et GitHub) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

# --- Vérification du téléphone par WhatsApp (Convessa) ---
CONVESSA_API_KEY=""
CONVESSA_API_URL="https://convessa.epac-uac-optica-chapter.bj"
OTP_TTL_MINUTES=3

# Emails
RESEND_API_KEY=""
MAIL_FROM="Fluxo <no-reply@fluxo.app>"

# Port de l'API
PORT=3000

# --- Cloudinary (stockage fichiers projet) ---
# 1. Créer un compte gratuit sur https://cloudinary.com
# 2. Dashboard > Settings > Upload > Upload presets > Add upload preset
#    - Signing Mode : Unsigned
#    - Folder : fluxo (optionnel)
#    - Copier le "Preset name"
# 3. Dashboard > Cloud Name (en haut à gauche)

CLOUDINARY_CLOUD_NAME="asjyngey"
CLOUDINARY_UPLOAD_PRESET="app-fluxo"
